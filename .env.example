# ──────────────────────────────────────────────────────────
# CivicVoice Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to source control.
# ──────────────────────────────────────────────────────────

# MapTiler API Key (free tier available at https://www.maptiler.com/cloud/)
# Used for the premium dark map tiles (MapTiler Dataviz Dark style).
# Without this, the app falls back to a dark-filtered OpenStreetMap style.
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_key_here

# ── Phase 2: Supabase ──────────────────────────────────────
# Get these from your Supabase project settings → API
# Leave blank to run in demo mode (uses local sample data, no live DB)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Phase 5: OpenRouter (AI features) ─────────────────────
# Get your key at https://openrouter.ai/
# Keep this server-side only — never prefix with NEXT_PUBLIC_
# OPENROUTER_API_KEY=your_openrouter_key_here
